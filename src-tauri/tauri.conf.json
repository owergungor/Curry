{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curry",
  "version": "2.2.0",
  "identifier": "com.curry.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Curry",
        "url": "index.html",
        "width": 1152,
        "height": 768,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "glow-overlay",
        "title": "Curry Overlay",
        "url": "glow.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Curry Contributors",
    "copyright": "Copyright 2026 Curry Contributors",
    "shortDescription": "Curry - Modern ambient glow notification companion",
    "longDescription": "Curry is a modern desktop notification companion and ambient screen glow utility.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "exceptionDomain": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2ODEzNDdEMTk2MEQ4NjMKUldSajJHQVpmVFNCZG16d3JtUUNHOUE2OWJyOURQaVNETkVEOXlJb0lMKzdheVIxL2R5ZXhwcFgK",
      "endpoints": [
        "https://github.com/owergungor/Curry/releases/latest/download/latest.json"
      ]
    }
  }
}
